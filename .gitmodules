[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "agecrypt"]
	path = agecrypt
	url = https://github.com/pedrobtz/agecrypt
[submodule "azr"]
	path = azr
	url = https://github.com/pedrobtz/azr
[submodule "data.sketches"]
	path = data.sketches
	url = https://github.com/pedrobtz/data.sketches
[submodule "decimal"]
	path = decimal
	url = https://github.com/pedrobtz/decimal
[submodule "imf.data"]
	path = imf.data
	url = https://github.com/pedrobtz/imf.data
[submodule "mdbx"]
	path = mdbx
	url = https://github.com/pedrobtz/mdbx
[submodule "openlineage"]
	path = openlineage
	url = https://github.com/pedrobtz/openlineage
[submodule "qio"]
	path = qio
	url = https://github.com/pedrobtz/qio
[submodule "quak"]
	path = quak
	url = https://github.com/pedrobtz/quak
[submodule "zucbor"]
	path = zucbor
	url = https://github.com/pedrobtz/zucbor
[submodule "zucsv"]
	path = zucsv
	url = https://github.com/pedrobtz/zucsv
[submodule "zufast"]
	path = zufast
