[submodule ".registry"]
	path = .registry
	url = https://github.com/pedrobtz/pedrobtz.r-universe.dev
	branch = HEAD
[submodule "agecrypt"]
	path = agecrypt
	url = https://github.com/pedrobtz/agecrypt
